# BAGR Agent Environment Configuration
# Copy this file to .env to configure local runs

# Ollama Endpoint Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL_NAME=gemma2:2b

# Autonomous Agent Token Budget
TOKEN_BUDGET=2048
MAX_REPAIR_RETRIES=3

# Resource & Controller Ceilings
MAX_RAM_MB=6500.0
MAX_LATENCY_SECONDS=180.0

# Pytest Sandbox Execution Timeout
PYTEST_TIMEOUT_SECONDS=20
